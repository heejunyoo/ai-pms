{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "Handoff Plan",
  "description": "목표 → Phase → 태스크. 파일 하나로 유지한다. 상위 모델의 컨텍스트가 아니라 디스크가 계획을 들고 있다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "spec_ref", "open_decisions", "phases", "tasks"],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 15,
      "description": "완성되면 무엇이 가능해지는지 한 문장. 절차가 아니라 결과."
    },
    "spec_ref": {
      "type": "string",
      "minLength": 3,
      "description": "근거 문서 경로(spec.md). 조사 없이 쓴 계획은 서브에이전트가 지어내게 만든다."
    },
    "open_decisions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "아직 상위 모델이 정하지 못한 설계 판단. implement 태스크가 있으면 반드시 비어 있어야 한다."
    },
    "verify_command": {
      "type": "string",
      "description": "리포 전체 검증 명령. 실제로 돌려 통과를 확인한 것만."
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "exit_check"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
          "name": { "type": "string", "minLength": 3 },
          "exit_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "expect_exit_code"],
            "description": "이 Phase 를 닫기 전에 상위 모델이 직접 돌린다. 하위 모델의 자기보고로 닫지 않는다.",
            "properties": {
              "command": { "type": "string", "minLength": 3 },
              "expect_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
              "expect_contains": { "type": "array", "items": { "type": "string" } }
            }
          },
          "rollback": {
            "type": "string",
            "description": "exit_check 실패 시 되돌리는 방법. 없으면 생략."
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "packet.schema.json" }
    }
  }
}
